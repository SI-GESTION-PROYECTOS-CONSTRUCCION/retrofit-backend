# ==========================================
# VARIABLES DE ENTORNO - RETROFIT
# ==========================================
# Este archivo es de ejemplo. No coloques contraseñas reales aquí.
# Para desarrollo local, cópialo a .env y ajusta los valores.
# En producción, estas variables se configuran en DigitalOcean App Platform.

# --- BASE DE DATOS (POSTGRESQL) ---
# En local suele ser jdbc:postgresql://localhost:5432/retrofit
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/retrofit
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin

# --- SEGURIDAD ---
# La clave secreta para firmar los tokens JWT (debe ser larga y segura)
JWT_SECRET=UnaClaveLocalSeguraDePruebaConMasDe32Caracteres2026

# --- DIGITALOCEAN SPACES (S3) ---
# Endpoint de la región, ej. https://atl1.digitaloceanspaces.com
SPACES_ENDPOINT=https://atl1.digitaloceanspaces.com
SPACES_REGION=atl1
SPACES_BUCKET=retrofit-local
SPACES_KEY=local-test-key
SPACES_SECRET=local-test-secret
